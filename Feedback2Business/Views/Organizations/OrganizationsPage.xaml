<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Feedback2Business.Views.Organizations.OrganizationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*" Padding="24">
        <!-- Page Header -->
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="Organisationer &amp; brands" Style="{StaticResource PageTitleStyle}" />
                <Label Text="Administrer organisationer, tilknyttede brands og deres oplysninger."
                       Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="+ Opret organisation"
                    Command="{Binding OpretOrganizationCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <!-- Two Column Main Body -->
        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="*,*" ColumnSpacing="20">
            <!-- Left Column: Organizations -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <!-- Search bar -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,6">
                    <Entry Placeholder="Søg organisationer..." Text="{Binding SearchText}" HeightRequest="36" />
                </Border>

                <!-- List of Organizations -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto,Auto" BackgroundColor="{StaticResource PrimaryBlueLight}">
                            <Label Text="Organisation" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Brands" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,16,0" />
                            <Label Grid.Column="2" Text="Surveys" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding Organizations}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedOrganization}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="12,6" Padding="12" Style="{StaticResource InnerCardStyle}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                                                            <Setter Property="StrokeThickness" Value="1" />
                                                            <Setter Property="BackgroundColor" Value="White" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="Stroke" Value="{StaticResource PrimaryBlue}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlueLight}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid ColumnDefinitions="*,40,40" ColumnSpacing="10">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding BrandCount}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding SurveyCount}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- Org Details & Inline Editor -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" HeightRequest="110" VerticalOptions="End">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Rediger Organisation" FontAttributes="Bold" FontSize="14" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding OrgNameBuffer}" Placeholder="Organisationsnavn" HeightRequest="38" />
                            <Button Grid.Column="1" Text="Gem" Command="{Binding GemOrganizationCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="38" />
                            <Button Grid.Column="2" Text="Slet" Command="{Binding SletOrganizationCommand}" BackgroundColor="Transparent" TextColor="Red" HeightRequest="38" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Right Column: Brands -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
                <!-- Brands List Card -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PrimaryBlueLight}">
                            <Label Text="Tilknyttede Brands" FontAttributes="Bold" TextColor="{StaticResource PrimaryBlue}" VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="+ Opret brand"
                                    Command="{Binding OpretBrandCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HeightRequest="30" Padding="12,0" FontSize="11" />
                        </Grid>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding Brands}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedBrand}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="12,6" Padding="12" Style="{StaticResource InnerCardStyle}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                                                            <Setter Property="StrokeThickness" Value="1" />
                                                            <Setter Property="BackgroundColor" Value="White" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="Stroke" Value="{StaticResource PrimaryBlue}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlueLight}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding LogoUrl}" FontSize="20" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource TextSecondary}" MaxLines="1" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding SurveyCountText}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- Brand Creator/Editor Card -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" HeightRequest="250" VerticalOptions="End">
                    <Grid>
                        <!-- No Brand Selected Placeholder -->
                        <VerticalStackLayout IsVisible="{Binding HasNoBrandSelected}"
                                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="Vælg et brand for at redigere oplysninger" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Editor Panel -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBrandSelected}">
                            <Label Text="Brand Detaljer &amp; Konfiguration" FontAttributes="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                <Label Text="Logo / Ikon:" VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding BrandLogoOptions}" SelectedItem="{Binding BrandLogoBuffer}" HeightRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                <Label Text="Navn:" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Text="{Binding BrandNameBuffer}" Placeholder="Brand navn" HeightRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                <Label Text="Beskrivelse:" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Text="{Binding BrandDescriptionBuffer}" Placeholder="Kort brand beskrivelse" HeightRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <Button Text="Vis Surveys" Command="{Binding OpenSurveysForBrandCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="36" IsVisible="{Binding IsNotCreatingBrand}" />
                                <Button Grid.Column="1" Text="Annuller" Command="{Binding AnnullerBrandCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="36" />
                                <Button Grid.Column="2" Text="Gem" Command="{Binding GemBrandCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="36" />
                                <Button Grid.Column="3" Text="Slet" Command="{Binding SletBrandCommand}" BackgroundColor="Transparent" TextColor="Red" HeightRequest="36" IsVisible="{Binding IsNotCreatingBrand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>


