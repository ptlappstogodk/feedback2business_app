<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Feedback2Business.Views.Shared.SettingsNavView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Style="{StaticResource CardStyle}">
        <VerticalStackLayout Padding="8" Spacing="4">
            <Button Text="Generelt" Clicked="OnGenereltClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" />
            <Button Text="App-indstillinger" Clicked="OnAppClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" />
            <Button Text="Sikkerhed" Clicked="OnSecurityClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" />
            <Button Text="Notifikationer" Clicked="OnNotificationsClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" />
            <Button Text="API &amp; integrationer" Clicked="OnIntegrationsClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" />
            <Button Text="Udseende" Clicked="OnAppearanceClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </Border>
</ContentView>


