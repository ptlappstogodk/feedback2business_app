<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Feedback2Business.Views.Shared.SectionCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Feedback2Business.Models"
    x:Name="This">

    <Border Style="{StaticResource InnerCardStyle}">
        <Border.GestureRecognizers>
            <DragGestureRecognizer CanDrag="True" DragStarting="OnSectionDragStarting" />
            <DropGestureRecognizer AllowDrop="True" Drop="OnSectionDrop" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="8" Padding="12">
            <!-- Section Header -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label Text="⋮⋮" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" FontSize="14" ToolTipProperties.Text="Træk for at flytte sektion" />
                
                <Entry Grid.Column="1"
                       Text="{Binding SectionTitle, Source={x:Reference This}, Mode=TwoWay}"
                       FontAttributes="Bold"
                       FontSize="15"
                       VerticalOptions="Center" />

                <Button Grid.Column="2"
                        Text="▲"
                        Clicked="OnMoveSectionUpClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        WidthRequest="28" HeightRequest="28" Padding="0" FontSize="11" ToolTipProperties.Text="Flyt sektion op" />

                <Button Grid.Column="3"
                        Text="▼"
                        Clicked="OnMoveSectionDownClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        WidthRequest="28" HeightRequest="28" Padding="0" FontSize="11" ToolTipProperties.Text="Flyt sektion ned" />

                <Button Grid.Column="4"
                        Text="🗑"
                        Clicked="OnDeleteSectionClicked"
                        BackgroundColor="Transparent"
                        TextColor="Red"
                        WidthRequest="28" HeightRequest="28" Padding="0" FontSize="14" ToolTipProperties.Text="Slet sektion" />
            </Grid>

            <!-- Questions List -->
            <CollectionView ItemsSource="{Binding SectionQuestions, Source={x:Reference This}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SurveyQuestionModel">
                        <Border Margin="0,4" Padding="8,6" Style="{StaticResource CardStyle}">
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer CanDrag="True" DragStarting="OnQuestionDragStarting" />
                                <DropGestureRecognizer AllowDrop="True" Drop="OnQuestionDrop" />
                                <TapGestureRecognizer Tapped="OnQuestionTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label Text="⋮⋮" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" FontSize="12" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayTitle}" FontAttributes="Bold" FontSize="13" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding TypeLabel}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="3"
                                        Text="▲"
                                        Clicked="OnMoveQuestionUpClicked"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        WidthRequest="24" HeightRequest="24" Padding="0" FontSize="10" ToolTipProperties.Text="Flyt spørgsmål op" />

                                <Button Grid.Column="4"
                                        Text="▼"
                                        Clicked="OnMoveQuestionDownClicked"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        WidthRequest="24" HeightRequest="24" Padding="0" FontSize="10" ToolTipProperties.Text="Flyt spørgsmål ned" />

                                <Button Grid.Column="5"
                                        Text="🗑"
                                        Clicked="OnDeleteQuestionClicked"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        WidthRequest="24" HeightRequest="24" Padding="0" FontSize="12" ToolTipProperties.Text="Slet spørgsmål" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add Question Button -->
            <Button Text="+ Tilføj spørgsmål"
                    Clicked="OnAddQuestionClicked"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="32"
                    FontSize="12"
                    HorizontalOptions="Start"
                    Margin="0,4,0,0" />
        </VerticalStackLayout>
    </Border>
</ContentView>


