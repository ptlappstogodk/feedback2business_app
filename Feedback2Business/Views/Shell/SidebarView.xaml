<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Feedback2Business.Views.Shell.SidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource SidebarBackground}">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Spacing="6">
            <Label Text="Feedback2Business" TextColor="White" FontSize="20" FontAttributes="Bold" />
            <Label Text="Konfiguration" TextColor="#B8C7E0" FontSize="12" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Margin="0,20,0,20" Spacing="4">
            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Overview_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Overblik" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Organizations_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Organisationer" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Brands_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Brands" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Users_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Brugere" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Templates_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 16H5V5h2v2h10V5h2v14z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Skabeloner" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Variables_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Variabler" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Media_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Mediebibliotek" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SettingsGeneral_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Indstillinger" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SettingsApp_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="App-indstillinger" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Roles_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Roller &amp; rettigheder" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ActivityLog_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Aktivitetslog" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Padding="10,8" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="0,12,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Logout_Clicked" />
                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Path Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                          Fill="White" WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Log ud" TextColor="White" FontSize="14" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Border Grid.Row="2"
                Padding="12"
                Stroke="#1C3A69"
                BackgroundColor="#0A2444">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border WidthRequest="32"
                        HeightRequest="32"
                        StrokeThickness="0"
                        BackgroundColor="#2F4B73"
                        StrokeShape="RoundRectangle 16">
                    <Label Text="{Binding CurrentUser.Initials}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="White"
                           FontSize="12" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" Spacing="0">
                    <Label Text="{Binding CurrentUser.Name}" TextColor="White" FontSize="13" />
                    <Label Text="{Binding CurrentUser.Role}" TextColor="#B8C7E0" FontSize="11" />
                </VerticalStackLayout>

                <Label Grid.Column="2" Text="›" TextColor="White" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentView>


